LONG AddIntServerEx(ULONG irq, UBYTE priority, BOOL edge, struct Interrupt *interrupt) (D0,D1,D2,A1)
LONG RemIntServerEx(ULONG irq, struct Interrupt *interrupt) (D0, A1)
LONG GetIntStatus(ULONG irq, BOOL *pending, BOOL *active, BOOL *enabled) (D0,A1,A2,A3)
LONG EnableInt(ULONG irq) (D0)
LONG DisableInt(ULONG irq) (D0)
LONG SetIntPriority(ULONG irq, UBYTE priority) (D0,D1)
LONG GetIntPriority(ULONG irq) (D0)
LONG SetIntTriggerEdge(ULONG irq) (D0)
LONG SetIntTriggerLevel(ULONG irq) (D0)
LONG RouteIntToCpu(ULONG irq, UBYTE cpu) (D0,D1)
LONG UnrouteIntFromCpu(ULONG irq, UBYTE cpu) (D0,D1)
LONG QueryIntRoute(ULONG irq) (D0)
LONG SetIntPending(ULONG irq) (D0)
LONG ClearIntPending(ULONG irq) (D0)
LONG SetIntActive(ULONG irq) (D0)
LONG ClearIntActive(ULONG irq) (D0)
LONG SetPriorityMask(UBYTE mask) (D0)
LONG GetPriorityMask(void) ()
LONG GetRunningPriority(void) ()
LONG GetHighestPending(void) ()
LONG GetControllerInfo(struct GICInfo *info) (A1)
* PC extension; all preceding GIC vector offsets remain unchanged.
LONG SetIntPolarity(ULONG irq, BOOL active_low) (D0,D1)
* PC OS gate and native arrival collection; existing vectors stay unchanged.
LONG SetDispatchEnabled(BOOL enabled) (D0)
LONG CollectInterrupts(void) ()
* Request an OS entry without changing callback gates or priority masks.
LONG RequestWakeup(void) ()
* Resolve a final device-tree controller descriptor; no registration or MMIO.
LONG ResolveInterrupt(APTR controller, const UBYTE *specifier, ULONG cells, struct InterruptRoute *route) (A0,A1,D0,A2)
* PC message allocation; existing vectors stay unchanged.
LONG AllocMessageInterrupts(ULONG count, struct InterruptMessage *messages) (D0,A0)
LONG FreeMessageInterrupts(ULONG first_irq, ULONG count) (D0,D1)
